+
+    def test_pull_abort_ongoing(
+        self, duts: list[DeviceAdapter], shells: list[Shell], transport_ready
+    ):
+        """BR_OPP_SERVER_PULL_BCARD_ABORT_ONGOING / BR_OPP_CLIENT_PULL_BCARD_ABORT_ONGOING
+        Multi-packet pull mode is enabled so the first GET is answered with a
+        CONTINUE and the GET stays outstanding, which is the precondition for
+        this case: the abort lands on an operation that is really in progress.
+        """
+        client_dut, server_dut = duts[0], duts[1]
+        client_sh, server_sh = shells[0], shells[1]
+        _reset(server_sh)
+        server_sh.exec_command("opp_s set_pull_multi 1")
+        assert _cmd_expect(client_sh, client_dut, "opp_c pull", "OPP client pull continue"), (
+            "Client did not observe the intermediate CONTINUE"
+        )
+        assert _cmd_expect(client_sh, client_dut, "opp_c abort", "OPP client abort success"), (
+            "Client abort during GET failed"
+        )
+        assert _wait_for(server_dut, "OPP server abort handled"), "Server did not abort the GET"
+        _reset(server_sh)
+
+    # ==================================================================
+    # Business Card Exchange (PUT + GET)
+    # ==================================================================
+
+    def test_exchange_success(
+        self, duts: list[DeviceAdapter], shells: list[Shell], transport_ready
+    ):
+        """BR_OPP_SERVER_EXCHANGE_BCARD_SUCCESS / BR_OPP_CLIENT_EXCHANGE_BCARD_SUCCESS"""
+        client_dut, server_dut = duts[0], duts[1]
+        client_sh, server_sh = shells[0], shells[1]
+        _reset(server_sh)
+        server_sh.exec_command(f"opp_s set_pull_rsp {RSP_SUCCESS}")
+
+        assert _cmd_expect(client_sh, client_dut, "opp_c push", "OPP client push success"), (
+            "Exchange PUT failed"
+        )
+        assert _wait_for(server_dut, "OPP server push complete"), "Server missed exchange PUT"
+        assert _cmd_expect(client_sh, client_dut, "opp_c pull", "OPP client pull success"), (
+            "Exchange GET failed"
+        )
+        assert _wait_for(server_dut, "OPP server pull success"), (
+            "Server did not complete the exchange GET"
+        )
+        _reset(server_sh)
+
+    def test_exchange_pull_not_found(
+        self, duts: list[DeviceAdapter], shells: list[Shell], transport_ready
+    ):
+        """BR_OPP_SERVER_EXCHANGE_BCARD_PULL_NOT_FOUND
+        BR_OPP_CLIENT_EXCHANGE_BCARD_PULL_NOT_FOUND
+        """
+        client_dut, server_dut = duts[0], duts[1]
+        client_sh, server_sh = shells[0], shells[1]
+        _reset(server_sh)
+        assert _cmd_expect(client_sh, client_dut, "opp_c push", "OPP client push success"), (
+            "Exchange PUT failed"
+        )
+
+        server_sh.exec_command(f"opp_s set_pull_rsp {RSP_NOT_FOUND}")
+        assert _cmd_expect(client_sh, client_dut, "opp_c pull", "OPP client pull not_found"), (
+            "Exchange GET NOT_FOUND not observed"
+        )
+        assert _wait_for(server_dut, "OPP server pull not_found"), (
+            "Server did not report NOT_FOUND for the exchange GET"
+        )
+        _reset(server_sh)
+
+    # ==================================================================
+    # Abort Ongoing Request
+    # ==================================================================
+
+    def test_abort_active_request(
+        self, duts: list[DeviceAdapter], shells: list[Shell], transport_ready
+    ):
+        """BR_OPP_SERVER_ABORT_ACTIVE_REQUEST / BR_OPP_CLIENT_ABORT_ACTIVE_REQUEST"""
+        client_dut, server_dut = duts[0], duts[1]
+        client_sh, server_sh = shells[0], shells[1]
+        _reset(server_sh)
+        assert _cmd_expect(client_sh, client_dut, "opp_c push_start", "OPP client push continue"), (
+            "Client did not start an active request"
+        )
+        assert _cmd_expect(client_sh, client_dut, "opp_c abort", "OPP client abort success"), (
+            "Client abort of active request failed"
+        )
+        assert _wait_for(server_dut, "OPP server abort handled"), "Server did not abort"
+
+    def test_abort_no_active_request(
+        self, duts: list[DeviceAdapter], shells: list[Shell], transport_ready
+    ):
+        """BR_OPP_SERVER_ABORT_NO_ACTIVE_REQUEST / BR_OPP_CLIENT_ABORT_NO_ACTIVE_REQUEST
+        With nothing outstanding, the API may reject with an error or the abort
+        callback may report SUCCESS; either way the session stays stable.
+        """
+        client_dut = duts[0]
+        client_sh = shells[0]
+        lines = _cmd(client_sh, "opp_c abort")
+        handled = _lines_match(lines, "OPP client abort") or _lines_match(
+            lines, "Unable to send abort"
+        )
+        assert handled or _wait_for(client_dut, "OPP client abort", max_wait_sec=5), (
+            "Client abort with no active request not handled gracefully"
+        )
+
+    # ==================================================================
+    # Service Discovery and PDU Utilities
+    # ==================================================================
+
+    def test_sdp_and_pdu(self, duts: list[DeviceAdapter], shells: list[Shell], transport_ready):
+        """BR_OPP_CLIENT_SDP_DISCOVERY
+        BR_OPP_SERVER_PDU_CREATION / BR_OPP_CLIENT_PDU_CREATION
+        SDP runs only in the 'transport_ready' fixture: the server registers
+        its record, and the client finds it with a ServiceSearchAttributeRequest
+        for the OBEXObjectPush UUID and reads only the RFCOMM channel from its
+        ProtocolDescriptorList. The rest of the record (Supported Formats List,
+        BluetoothProfileDescriptorList, Service Name) is not checked, so
+        BR_OPP_SERVER_SDP_SERVICE_RECORD is only partly covered. Here we verify
+        PDU allocation on both roles.
+        """
+        client_dut, server_dut = duts[0], duts[1]
+        client_sh, server_sh = shells[0], shells[1]
+        assert _cmd_expect(server_sh, server_dut, "opp_s create_pdu", "OPP server create_pdu ok"), (
+            "Server PDU allocation failed"
+        )
+        assert _cmd_expect(client_sh, client_dut, "opp_c create_pdu", "OPP client create_pdu ok"), (
+            "Client PDU allocation failed"
+        )
+
+    # ==================================================================
+    # OBEX Disconnection (single OBEX disconnect for the session)
+    # ==================================================================
+
+    def test_obex_disconnect_success(
+        self, duts: list[DeviceAdapter], shells: list[Shell], transport_ready
+    ):
+        """BR_OPP_SERVER_OBEX_DISCONNECT_SUCCESS / BR_OPP_CLIENT_OBEX_DISCONNECT_SUCCESS
+        The single OBEX disconnect of the session: it is accepted, so both
+        sides end up with the OBEX session closed and the transport still up
+        for the final RFCOMM transport teardown.
+        """
+        client_dut, server_dut = duts[0], duts[1]
+        client_sh, server_sh = shells[0], shells[1]
+        _reset(server_sh)
+        assert _cmd_expect(
+            client_sh, client_dut, "opp_c obex_disconnect", "OPP client OBEX disconnected"
+        ), "Client OBEX not disconnected"
+        assert _wait_for(server_dut, "OPP server OBEX disconnected"), "Server OBEX not disconnected"
+
+    # ==================================================================
+    # Transport Disconnection (runs last)
+    # ==================================================================
+
+    def test_transport_disconnect(
+        self, duts: list[DeviceAdapter], shells: list[Shell], transport_ready
